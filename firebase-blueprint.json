{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account and role metadata.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["customer", "umkm", "admin"] },
        "managedStoreId": { "type": "string", "maxLength": 128 },
        "points": { "type": "number" },
        "streakCount": { "type": "number" },
        "lastCheckInDate": { "type": "string", "maxLength": 32 },
        "eggTickets": { "type": "number" },
        "phone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 400 },
        "city": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "displayName", "role"]
    },
    "UmkmStore": {
      "title": "UmkmStore",
      "description": "UMKM Binaan store profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 140 },
        "description": { "type": "string", "maxLength": 1200 },
        "category": { "type": "string", "maxLength": 80 },
        "city": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 400 },
        "whatsapp": { "type": "string", "maxLength": 40 },
        "ownerName": { "type": "string", "maxLength": 120 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "photoUrl": { "type": "string", "maxLength": 800000 },
        "legalitySummary": { "type": "string", "maxLength": 300 },
        "foundedYear": { "type": "string", "maxLength": 20 },
        "foundingStory": { "type": "string", "maxLength": 3000 },
        "isVerifiedUmkm": { "type": "boolean" },
        "isInitialStore": { "type": "boolean" },
        "ratingAvg": { "type": "number" },
        "reviewCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["name", "category"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category for B-Market.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 300 }
      },
      "required": ["name", "slug"]
    },
    "Product": {
      "title": "Product",
      "description": "UMKM product synchronized between B-Save and B-Market.",
      "type": "object",
      "properties": {
        "storeId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "storeName": { "type": "string", "minLength": 1, "maxLength": 140 },
        "storeOwnerUid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "category": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 2000 },
        "composition": { "type": "string", "maxLength": 1000 },
        "specifications": { "type": "string", "maxLength": 1000 },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "initialStock": { "type": "number" },
        "soldCount": { "type": "number" },
        "ratingAvg": { "type": "number" },
        "reviewCount": { "type": "number" },
        "productionDate": { "type": "string", "maxLength": 64 },
        "expiryDate": { "type": "string", "maxLength": 64 },
        "legalityNumber": { "type": "string", "maxLength": 140 },
        "photoUrl": { "type": "string", "maxLength": 800000 },
        "videoUrl": { "type": "string", "maxLength": 1000 },
        "videoTitle": { "type": "string", "maxLength": 200 },
        "isPublished": { "type": "boolean" },
        "bchainStatus": { "type": "string", "enum": ["VERIFIED", "PENDING VERIFICATION", "NOT VERIFIED"] },
        "bchainId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["storeId", "storeName", "name", "category", "isPublished"]
    },
    "InventoryMovement": {
      "title": "InventoryMovement",
      "description": "Stock mutation ledger for B-Save.",
      "type": "object",
      "properties": {
        "storeId": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 160 },
        "type": { "type": "string", "enum": ["IN", "OUT", "INITIAL", "ORDER"] },
        "qty": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "note": { "type": "string", "maxLength": 300 },
        "actorUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["storeId", "productId", "type", "qty"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "Customer liked product.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "productId"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer product review and rating.",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "maxLength": 128 },
        "storeId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1000 },
        "photoUrl": { "type": "string", "maxLength": 800000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["productId", "storeId", "userId", "rating", "comment"]
    },
    "Cart": {
      "title": "Cart",
      "description": "Customer shopping cart.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order.",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "maxLength": 64 },
        "customerUid": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 40 },
        "shippingAddress": { "type": "string", "maxLength": 500 },
        "storeId": { "type": "string", "maxLength": 128 },
        "storeName": { "type": "string", "maxLength": 140 },
        "storeOwnerUid": { "type": "string", "maxLength": 128 },
        "subtotal": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["Menunggu Konfirmasi", "Diproses", "Dikirim", "Selesai", "Dibatalkan"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["orderNumber", "customerUid", "storeId", "total", "status"]
    },
    "ProductVerification": {
      "title": "ProductVerification",
      "description": "B-CHAIN blockchain product verification record.",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 160 },
        "storeId": { "type": "string", "maxLength": 128 },
        "storeName": { "type": "string", "maxLength": 140 },
        "productCode": { "type": "string", "maxLength": 80 },
        "batchNumber": { "type": "string", "maxLength": 80 },
        "productionDate": { "type": "string", "maxLength": 64 },
        "shelfLife": { "type": "string", "maxLength": 120 },
        "expiryDate": { "type": "string", "maxLength": 64 },
        "legalityInfo": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["VERIFIED", "PENDING VERIFICATION", "NOT VERIFIED"] },
        "txId": { "type": "string", "maxLength": 128 },
        "blockchainHash": { "type": "string", "maxLength": 160 },
        "blockNumber": { "type": "number" },
        "network": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["productId", "productName", "storeId", "productCode", "status", "txId", "blockchainHash"]
    },
    "VerificationHistory": {
      "title": "VerificationHistory",
      "description": "B-CHAIN immutable verification event log.",
      "type": "object",
      "properties": {
        "verificationId": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 160 },
        "action": { "type": "string", "maxLength": 140 },
        "status": { "type": "string", "maxLength": 40 },
        "txId": { "type": "string", "maxLength": 128 },
        "blockchainHash": { "type": "string", "maxLength": 160 },
        "note": { "type": "string", "maxLength": 400 },
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["verificationId", "productId", "action", "txId", "blockchainHash"]
    },
    "AiConversation": {
      "title": "AiConversation",
      "description": "B-AI customer assistant chat history.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 160 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId"]
    },
    "MarketingContent": {
      "title": "MarketingContent",
      "description": "B-Smart digital marketing content and calendar entry.",
      "type": "object",
      "properties": {
        "storeId": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 160 },
        "channel": { "type": "string", "enum": ["Instagram", "Facebook", "WhatsApp Business", "B-Market Promo"] },
        "title": { "type": "string", "maxLength": 160 },
        "headline": { "type": "string", "maxLength": 240 },
        "caption": { "type": "string", "maxLength": 3000 },
        "cta": { "type": "string", "maxLength": 200 },
        "scheduledDate": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["Draft", "Scheduled", "Published"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["storeId", "ownerUid", "channel", "title", "status"]
    },
    "FinancialTransaction": {
      "title": "FinancialTransaction",
      "description": "B-Finance income and expense ledger entry.",
      "type": "object",
      "properties": {
        "storeId": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["PEMASUKAN", "PENGELUARAN"] },
        "category": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 300 },
        "amount": { "type": "number" },
        "date": { "type": "string", "maxLength": 32 },
        "source": { "type": "string", "maxLength": 60 },
        "orderId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["storeId", "type", "category", "amount", "date"]
    },
    "EducationalGame": {
      "title": "EducationalGame",
      "description": "Customer B-EDU quiz and educational game.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 160 },
        "category": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 500 },
        "pointsPerCorrect": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["title", "category", "pointsPerCorrect", "isActive"]
    },
    "UserPoint": {
      "title": "UserPoint",
      "description": "Customer reward point history entry.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["EARN", "REDEEM"] },
        "reason": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "amount", "type", "reason"]
    },
    "Voucher": {
      "title": "Voucher",
      "description": "Reward Center redeemable voucher.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 160 },
        "description": { "type": "string", "maxLength": 400 },
        "pointsCost": { "type": "number" },
        "discountLabel": { "type": "string", "maxLength": 80 },
        "quota": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["title", "pointsCost", "discountLabel", "quota", "isActive"]
    },
    "VoucherRedemption": {
      "title": "VoucherRedemption",
      "description": "Customer redeemed voucher record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "voucherId": { "type": "string", "maxLength": 128 },
        "voucherTitle": { "type": "string", "maxLength": 160 },
        "voucherCode": { "type": "string", "maxLength": 64 },
        "pointsSpent": { "type": "number" },
        "status": { "type": "string", "enum": ["Aktif", "Terpakai"] },
        "redeemedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "voucherId", "voucherTitle", "voucherCode", "pointsSpent", "status"]
    },
    "TrainingProgram": {
      "title": "TrainingProgram",
      "description": "UMKM B-Edu training program.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 160 },
        "mode": { "type": "string", "enum": ["Online", "Offline"] },
        "schedule": { "type": "string", "maxLength": 120 },
        "location": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 800 },
        "quota": { "type": "number" },
        "registeredCount": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["title", "mode", "schedule", "quota"]
    },
    "TrainingRegistration": {
      "title": "TrainingRegistration",
      "description": "UMKM training registration.",
      "type": "object",
      "properties": {
        "programId": { "type": "string", "maxLength": 128 },
        "programTitle": { "type": "string", "maxLength": 160 },
        "userId": { "type": "string", "maxLength": 128 },
        "storeId": { "type": "string", "maxLength": 128 },
        "storeName": { "type": "string", "maxLength": 140 },
        "applicantName": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["Terdaftar", "Selesai", "Dibatalkan"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["programId", "userId", "status"]
    },
    "Mentor": {
      "title": "Mentor",
      "description": "BSI UMKM Center mentor profile.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "expertise": { "type": "string", "maxLength": 140 },
        "bio": { "type": "string", "maxLength": 600 },
        "schedule": { "type": "string", "maxLength": 160 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["name", "expertise", "schedule"]
    },
    "MentoringSession": {
      "title": "MentoringSession",
      "description": "UMKM mentoring consultation booking.",
      "type": "object",
      "properties": {
        "mentorId": { "type": "string", "maxLength": 128 },
        "mentorName": { "type": "string", "maxLength": 120 },
        "userId": { "type": "string", "maxLength": 128 },
        "storeId": { "type": "string", "maxLength": 128 },
        "storeName": { "type": "string", "maxLength": 140 },
        "topic": { "type": "string", "maxLength": 300 },
        "requestedDate": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["Menunggu Jadwal", "Disetujui", "Selesai"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["mentorId", "userId", "topic", "status"]
    },
    "LearningMaterial": {
      "title": "LearningMaterial",
      "description": "UMKM learning module or BSI UMKM Center support info.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 160 },
        "category": { "type": "string", "maxLength": 80 },
        "type": { "type": "string", "enum": ["Modul Digital", "Video Pembelajaran", "Program Pendampingan"] },
        "duration": { "type": "string", "maxLength": 40 },
        "summary": { "type": "string", "maxLength": 400 },
        "content": { "type": "string", "maxLength": 4000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["title", "category", "type"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notification.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 160 },
        "message": { "type": "string", "maxLength": 400 },
        "type": { "type": "string", "maxLength": 40 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "title", "message", "isRead"]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Ecosystem settings managed by admin.",
      "type": "object",
      "properties": {
        "promoBannerTitle": { "type": "string", "maxLength": 160 },
        "promoBannerSubtitle": { "type": "string", "maxLength": 300 },
        "pointsPerQuizCorrect": { "type": "number" },
        "pointsPerOrder": { "type": "number" },
        "bchainNetwork": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["promoBannerTitle", "pointsPerQuizCorrect"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System audit log entry.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorName": { "type": "string", "maxLength": 120 },
        "actorRole": { "type": "string", "maxLength": 40 },
        "action": { "type": "string", "maxLength": 160 },
        "targetType": { "type": "string", "maxLength": 80 },
        "targetId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["actorUid", "action", "targetType"]
    },
    "StoreChatMessage": {
      "title": "StoreChatMessage",
      "description": "Direct in-app chat message between customer and UMKM store.",
      "type": "object",
      "properties": {
        "storeId": { "type": "string", "maxLength": 128 },
        "storeName": { "type": "string", "maxLength": 140 },
        "customerUid": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 120 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 160 },
        "senderRole": { "type": "string", "enum": ["customer", "umkm"] },
        "senderName": { "type": "string", "maxLength": 120 },
        "text": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["storeId", "customerUid", "senderRole", "text", "createdAt"]
    }
  },
  "firestore": {
